@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <FEXCore/Utils/CompilerDefs.h>
+
+#include <cstdint>
+
+namespace FEXCore {
+// The timer the guest's TSC counts, when a frontend sets one (macOS: rdtsc gives nanoseconds of the host's
+// mach_absolute_time).  Mrs is the timer read with its destination register left 0, OffsetAddr a 64-bit offset
+// added to it that is read again until it holds still, and the sum is scaled by Numer / Denom.  macOS on Apple M4
+// and later runs CNTVCT_EL0 at 1 GHz in a process that was executed and at 24 MHz in one that was forked, while
+// mach_absolute_time's timer is the same in both.  Set once by the frontend before any code is translated.
+struct HostTimer {
+  uint32_t Mrs {};
+  bool Isb {};
+  uint64_t OffsetAddr {};
+  uint32_t Numer {};
+  uint32_t Denom {};
+};
+
+FEX_DEFAULT_VISIBILITY extern HostTimer TSCTimer;
+} // namespace FEXCore
