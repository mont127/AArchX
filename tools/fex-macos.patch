+#ifdef __APPLE__
+// macOS has no getdents64: the same records, from readdir on a duplicate of the descriptor, one open
+// directory stream per descriptor so that a walk may recurse into another directory meanwhile.
+static ssize_t getdents64(int fd, void* buf, size_t size) {
+  struct Stream {
+    int fd;
+    DIR* dir;
+    struct dirent* pending;
+    bool done;
+  };
+  static thread_local Stream streams[16] = {};
+  static thread_local bool init = false;
+  if (!init) {
+    for (auto& s : streams) {
+      s.fd = -1;
+    }
+    init = true;
+  }
+  Stream* st = nullptr;
+  for (auto& s : streams) {
+    if (s.fd == fd && s.dir) {
+      st = &s;
+      break;
+    }
+  }
+  if (!st) {
+    for (auto& s : streams) {
+      if (!s.dir) {
+        st = &s;
+        break;
+      }
+    }
+    if (!st) {
+      errno = EMFILE;
+      return -1;
+    }
+    int nfd = ::dup(fd);
+    DIR* d = nfd >= 0 ? ::fdopendir(nfd) : nullptr;
+    if (!d) {
+      if (nfd >= 0) {
+        ::close(nfd);
+      }
+      return -1;
+    }
+    *st = {fd, d, nullptr, false};
+  }
+  if (st->done) {
+    ::closedir(st->dir);
+    *st = {-1, nullptr, nullptr, false};
+    return 0;
+  }
+  size_t off = 0;
+  for (;;) {
+    struct dirent* e = st->pending ? st->pending : ::readdir(st->dir);
+    st->pending = nullptr;
+    if (!e) {
+      st->done = true;
+      if (off == 0) {
+        ::closedir(st->dir);
+        *st = {-1, nullptr, nullptr, false};
+      }
+      return static_cast<ssize_t>(off);
+    }
+    if (off + e->d_reclen > size) {
+      if (off == 0) {
+        errno = EINVAL;
+        return -1;
+      }
+      st->pending = e;
+      return static_cast<ssize_t>(off);
+    }
+    memcpy(static_cast<char*>(buf) + off, e, e->d_reclen);
+    off += e->d_reclen;
+  }
+}
+#endif
