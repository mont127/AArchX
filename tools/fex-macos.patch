+void ContextImpl::AddPlainTrampolineIRHandler(uintptr_t Entrypoint, uintptr_t Target) {
+  AddCustomIREntrypoint(
+    Entrypoint,
+    [Target](uintptr_t Entrypoint, FEXCore::IR::IREmitter* emit) {
+      auto IRHeader = emit->_IRHeader(emit->Invalid(), Entrypoint, 0, 0, 0, 0);
+      auto Block = emit->CreateCodeNode(true, 0);
+      IRHeader.first->Blocks = emit->WrapNode(Block);
+      emit->SetCurrentCodeBlock(Block);
+      emit->_ExitFunction(IR::OpSize::i64Bit, emit->Constant(Target), IR::BranchHint::None, emit->Invalid(), emit->Invalid());
+    },
+    ThunkHandler, (void*)Target);
