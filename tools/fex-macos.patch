new file mode 100644
index 0000000..5d5239b
--- /dev/null
+++ b/FEXCore/include/FEXCore/Core/GuestAddressMap.h
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <FEXCore/Utils/CompilerDefs.h>
+
+#include <cstdint>
+
+namespace FEXCore {
+// Where guest memory lives when it is not at the guest's own address (macOS frontends: an arm64 process cannot map
+// the low 4 GB, so a Wine process's low window lives at LowBase and the top strip below the commpage at TopBase).
+// A guest address below LowLimit is at address | (1 << LowShift) on the host; one in [TopLo, TopHi) at
+// address - TopLo + TopBase; any other at itself.  Set once by the frontend before any code is translated.
+struct GuestAddressMap {
+  bool Enabled {};
+  uint64_t LowLimit {};
+  uint32_t LowShift {};
+  uint64_t TopLo {};
+  uint64_t TopHi {};
+  uint64_t TopBase {};
+
+  uint64_t ToHost(uint64_t Address) const {
+    if (!Enabled) {
+      return Address;
+    }
+    if (Address < LowLimit) {
+      return Address | (1ULL << LowShift);
+    }
+    if (Address - TopLo < TopHi - TopLo) {
+      return Address - TopLo + TopBase;
+    }
+    return Address;
+  }
+};
+
+FEX_DEFAULT_VISIBILITY extern GuestAddressMap GuestMap;
+} // namespace FEXCore
