diff --git a/FEXCore/include/FEXCore/Utils/JITWriteScope.h b/FEXCore/include/FEXCore/Utils/JITWriteScope.h
new file mode 100644
index 0000000..a714b4d
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/JITWriteScope.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#ifdef __APPLE__
+#include <pthread.h>
+#endif
+
+namespace FEXCore::Utils {
+// macOS maps JIT memory with MAP_JIT, which a thread sees either writable or executable, never both.
+// Hold one of these while writing code; nested scopes keep the thread writable until the outermost one ends.
+// Elsewhere code memory is RWX and this does nothing.
+class JITWriteScope final {
+public:
+#ifdef __APPLE__
+  JITWriteScope() {
+    if (Depth++ == 0) {
+      pthread_jit_write_protect_np(0);
+    }
+  }
+  ~JITWriteScope() {
+    if (--Depth == 0) {
+      pthread_jit_write_protect_np(1);
+    }
+  }
+#else
+  JITWriteScope() = default;
+#endif
+  JITWriteScope(const JITWriteScope&) = delete;
+  JITWriteScope& operator=(const JITWriteScope&) = delete;
+
+private:
+#ifdef __APPLE__
+  static inline thread_local int Depth = 0;
+#endif
+};
+} // namespace FEXCore::Utils
