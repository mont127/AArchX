+// Guest addresses that are not host addresses (FEXCore::GuestMap; a Wine process on macOS, whose low window and top
+// strip live elsewhere).  Dst gets the host address of guest address Src (Dst may be Src).  No flags are touched:
+// translated code keeps the guest's in NZCV across memory accesses.  GUEST_XLAT_TMP is the scratch; the top strip's
+// path, taken only for addresses in the 4 GB below 0x800000000000, borrows x0 and x1 from the stack.
+void Arm64JITCore::EmitGuestToHost(ARMEmitter::Register Dst, ARMEmitter::Register Src) {
+  const auto& M = FEXCore::GuestMap;
+  ARMEmitter::ForwardLabel Strip {};
+  ARMEmitter::ForwardLabel Done {};
+  lsr(ARMEmitter::Size::i64Bit, GUEST_XLAT_TMP, Src.X(), 32);
+  eor(ARMEmitter::Size::i64Bit, GUEST_XLAT_TMP, GUEST_XLAT_TMP, M.TopLo >> 32);
+  (void)cbz(ARMEmitter::Size::i64Bit, GUEST_XLAT_TMP, &Strip);
+  lsr(ARMEmitter::Size::i64Bit, GUEST_XLAT_TMP, Src.X(), 32);
+  sub(ARMEmitter::Size::i64Bit, GUEST_XLAT_TMP, GUEST_XLAT_TMP, M.LowLimit >> 32);
+  lsr(ARMEmitter::Size::i64Bit, GUEST_XLAT_TMP, GUEST_XLAT_TMP, 63);
+  orr(ARMEmitter::Size::i64Bit, Dst.X(), Src.X(), GUEST_XLAT_TMP, ARMEmitter::ShiftType::LSL, M.LowShift);
+  (void)b(&Done);
+  (void)Bind(&Strip);
+  stp<ARMEmitter::IndexType::PRE>(ARMEmitter::XReg::x0, ARMEmitter::XReg::x1, ARMEmitter::Reg::rsp, -16);
+  mov(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r0, Src.X());
+  LoadConstant(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r1, M.TopLo);
+  sub(ARMEmitter::Size::i64Bit, GUEST_XLAT_TMP, ARMEmitter::Reg::r0, ARMEmitter::Reg::r1);
+  LoadConstant(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r1, M.TopHi - M.TopLo);
+  sub(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r1, GUEST_XLAT_TMP, ARMEmitter::Reg::r1);
+  bic(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r1, ARMEmitter::Reg::r1, GUEST_XLAT_TMP);
+  asr(ARMEmitter::Size::i64Bit, ARMEmitter::Reg::r1, ARMEmitter::Reg::r1, 63);
+  LoadConstant(ARMEmitter::Size::i64Bit, GUEST_XLAT_TMP, M.TopBase - M.TopLo);
+  and_(ARMEmitter::Size::i64Bit, GUEST_XLAT_TMP, GUEST_XLAT_TMP, ARMEmitter::Reg::r1);
+  add(ARMEmitter::Size::i64Bit, Dst.X(), ARMEmitter::Reg::r0, GUEST_XLAT_TMP);
+  ldp<ARMEmitter::IndexType::POST>(ARMEmitter::XReg::x0, ARMEmitter::XReg::x1, ARMEmitter::Reg::rsp, 16);
+  (void)Bind(&Done);
+}
+
+// The register an access to guest Base goes through: Base itself, or GUEST_XLAT holding its host address.
+ARMEmitter::Register Arm64JITCore::GuestMemReg(ARMEmitter::Register Base) {
+  if (!FEXCore::GuestMap.Enabled) {
+    return Base;
+  }
+  EmitGuestToHost(GUEST_XLAT, Base);
+  return GUEST_XLAT;
+}
+
+// The same for guest Base + Offset: with translation the offset is folded into GUEST_XLAT and Offset is cleared.
+ARMEmitter::Register Arm64JITCore::GuestMemReg(IR::OpSize AccessSize, ARMEmitter::Register Base, IR::OrderedNodeWrapper& Offset,
+                                               IR::MemOffsetType OffsetType, uint8_t OffsetScale) {
+  if (!FEXCore::GuestMap.Enabled) {
+    return Base;
+  }
+  const auto Addr = ApplyMemOperand(AccessSize, Base, GUEST_XLAT, Offset, OffsetType, OffsetScale);
+  Offset = IR::OrderedNodeWrapper::WrapOffset(0);
+  EmitGuestToHost(GUEST_XLAT, Addr);
+  return GUEST_XLAT;
+}
